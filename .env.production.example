# Production environment variables for Railway (Molecule Enrollment CRM)
# Set these in Railway → your service → Variables. Do NOT commit real values.
# Provider secrets (Razorpay/AiSensy) can be set here OR entered in-app at
# Settings → Integrations (which encrypts them in the DB and overrides env).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=            # https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # publishable/anon key
SUPABASE_SERVICE_ROLE_KEY=           # secret/service-role key (server-only)

# --- Secret store master key (required) ---
# Encrypts integration_settings at rest. openssl rand -hex 32. KEEP STABLE once
# any secret is saved via Settings → Integrations, or those secrets can't decrypt.
ENCRYPTION_KEY=

# --- Cron (required) ---
# Bearer token the scheduled job uses to call /api/cron/scan. openssl rand -hex 32.
CRON_SECRET=

# --- Business (required) ---
BUSINESS_STATE=MH                    # your GST-registered state code

# --- App (required) ---
NEXT_PUBLIC_APP_URL=                 # https://<your-railway-domain>  (no trailing slash)

# --- CAPTCHA (Altcha, self-hosted) ---
ALTCHA_HMAC_KEY=                     # openssl rand -hex 32 (server-only)
NEXT_PUBLIC_CAPTCHA_ENABLED=true     # 'true' to enforce the widget + ingest check

# --- Razorpay (optional here; can be set in Settings → Integrations instead) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AiSensy (optional here; can be set in Settings → Integrations instead) ---
AISENSY_API_KEY=
AISENSY_WEBHOOK_SECRET=              # only needed for the inbound chat webhook (Pro plan)
