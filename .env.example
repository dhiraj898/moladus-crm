# Molecule Enrollment — environment variables
# Copy to .env.local and fill in. All secrets are server-side only.
# NEXT_PUBLIC_* values are exposed to the browser; everything else stays server-side.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Integrations — master key for the encrypted secret store (Spec A).
# Server-only, required. 32-byte hex — generate via `openssl rand -hex 32`.
# Provider secrets below may be left blank here once set in the Integrations UI
# (DB overrides env; env stays a fallback).
ENCRYPTION_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AiSensy
AISENSY_API_KEY=
# Project API Custom App shared secret — HMAC key for inbound webhook signatures
AISENSY_WEBHOOK_SECRET=

# Altcha (self-hosted proof-of-work CAPTCHA)
# ALTCHA_HMAC_KEY is server-only — generate via `openssl rand -hex 32`.
ALTCHA_HMAC_KEY=
# Set to `true` to render the widget + enforce verification on ingest.
NEXT_PUBLIC_CAPTCHA_ENABLED=

# Business — GST home state code, e.g. MH
BUSINESS_STATE=

# App — public base URL, e.g. https://your-railway-domain.up.railway.app
NEXT_PUBLIC_APP_URL=

# Cron — shared secret for the SLA scanner route (Authorization: Bearer <value>)
CRON_SECRET=
